[Unit]
Description=AUCTORISEAL Authority Service
After=network.target

[Service]
Type=simple
User=auctoriseal
Group=auctoriseal
WorkingDirectory=/opt/auctoriseal
Environment=AUCTORISEAL_BIND=127.0.0.1
Environment=AUCTORISEAL_PORT=8080
Environment=AUCTORISEAL_DB=/opt/auctoriseal/ledger.sqlite
ExecStart=/usr/bin/python3 -m auctoriseal.api.server
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/auctoriseal

[Install]
WantedBy=multi-user.target
